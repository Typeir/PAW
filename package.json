{
  "name": "paw-cli",
  "version": "0.1.0",
  "description": "Portable Agentic Workflows — quality gates, hooks, and agent memory for GitHub Copilot",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "paw": "bin/paw.mjs",
    "paw-setup": "bin/paw-setup.mjs"
  },
  "files": [
    "bin/",
    "packages/"
  ],
  "scripts": {
    "paw": "node bin/paw.mjs",
    "pawd": "node bin/paw.mjs __pawd .",
    "paw-tui": "node bin/paw.mjs tui",
    "paw-setup": "node bin/paw-setup.mjs",
    "init": "node bin/paw.mjs init",
    "sync": "node bin/paw.mjs sync",
    "gates": "node bin/paw.mjs gates",
    "gates:changed": "node bin/paw.mjs gates",
    "gates:staged": "node bin/paw.mjs gates --staged",
    "typecheck": "tsc --noEmit --project ../../.paw/tsconfig.json",
    "build:console": "npm --prefix packages/gui run build",
    "demo": "npm run build:console && node bin/paw.mjs ui packages/cli/test/fixtures/demo.swarm.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@github/copilot-sdk": "1.0.8",
    "kysely": "^0.29.4",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
