{
  "name": "paw-cli",
  "version": "0.1.0",
  "description": "Portable Agentic Workflows — quality gates, hooks, and agent memory for GitHub Copilot",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "paw": "dist/cli.mjs",
    "paw-setup": "dist/paw-setup.mjs"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "init": "node dist/cli.mjs init",
    "sync": "node dist/cli.mjs sync",
    "gates": "npx tsx pawGates.ts",
    "gates:changed": "npx tsx pawGates.ts --changed-only",
    "gates:staged": "npx tsx pawGates.ts --staged",
    "typecheck": "tsc --noEmit --project ../../.paw/tsconfig.json",
    "paw": "node bin/paw.mjs",
    "pawd": "node bin/pawd.mjs",
    "paw-tui": "node bin/paw-tui.mjs",
    "build:console": "npm --prefix packages/gui run build",
    "demo": "npm run build:console && node bin/paw.mjs ui packages/cli/test/fixtures/ready.config.json packages/cli/test/fixtures/demo.swarm.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "@github/copilot-sdk": "1.0.8",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
