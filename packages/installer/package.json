{
  "name": "@paw/installer",
  "version": "0.0.0",
  "private": true,
  "description": "PAW installer — pure planners for OS/shell detection, PATH activation, repo-root discovery, and per-repo init; behind injected ports so the decisions are testable and the writes are the only shell.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "paw-setup": "./src/main.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "sea": "node sea/build.mjs"
  },
  "dependencies": {
    "@paw/adapters": "file:../adapters",
    "@paw/core": "file:../core"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.0",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
