{
  "name": "@paw/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "PAW driven adapters — implementations of @paw/core's ports (process, store, model). Imported by consumers; never by core.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paw/core": "file:../core",
    "kysely": "^0.29.4",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
