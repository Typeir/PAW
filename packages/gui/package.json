{
  "name": "@paw/gui",
  "version": "0.0.0",
  "private": true,
  "description": "PAW GUI — a React driving adapter that consumes @paw/core and renders a live PawSnapshot served by pawd.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@paw/core": "file:../core",
    "@paw/cosmetics": "file:../cosmetics",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
